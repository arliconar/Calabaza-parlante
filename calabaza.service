[Unit]
Description=Servicio de Auto-inicio Calabaza Parlante IA
After=network-online.target bluetooth.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=angel
Group=angel

Environment=HOME=/home/angel
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native

ExecStart=/bin/bash "/home/angel/Calabaza-parlante/start_calabaza.sh"

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
